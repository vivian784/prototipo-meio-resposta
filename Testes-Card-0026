function renderAcesso(){
  var el = document.getElementById('categoriasAcesso');
  el.innerHTML = categoriasAcesso.map(function(c){
    var header = '<div class="card-header" id="'+c.id+'"><span>'+c.nome+'</span><span class="pill">'+c.scenarios.length+' item(ns)</span></div>';
    var scenarios = c.scenarios.map(function(s){
      var isEdited = overrides.hasOwnProperty(s.id) && overrides[s.id] !== s.status;
      return '<div class="scenario'+(isEdited?' edited':'')+'"><div class="sc-head"><span class="sc-title">'+s.id+' — '+s.titulo+'</span>'+statusGroup(s)+'</div>'+
        '<div class="sc-desc">'+s.desc+'</div>'+
        (s.obs? '<div class="obs">'+s.obs+'</div>' : '')+
        (s.evidence? '<div class="evidence">'+s.evidence.replace(/\n/g,'<br>')+'</div>' : '')+
        (s.img? '<div class="evidence-img"><img src="'+s.img+'" alt="'+(s.imgCap||'Print de evidência')+'" loading="lazy"><div class="cap">📷 '+(s.imgCap||'')+'</div></div>' : '')+
        '</div>';
    }).join("");
    return '<div class="card">'+header+'<div class="card-body">'+scenarios+'</div></div>';
  }).join("");
}

function renderSummary(){
  var counts = {passou:0, falhou:0, bloqueado:0, "nao-testado":0};
  categoriasGherkin.forEach(function(s){ counts[currentStatus(s)]++; });
  categoriasAcesso.forEach(function(c){ c.scenarios.forEach(function(s){ counts[currentStatus(s)]++; }); });
  var el = document.getElementById('summary');
  el.innerHTML =
    '<div class="box passou"><div class="n">'+counts.passou+'</div><div class="l">Passou</div></div>'+
    '<div class="box falhou"><div class="n">'+counts.falhou+'</div><div class="l">Falhou</div></div>'+
    '<div class="box bloqueado"><div class="n">'+counts.bloqueado+'</div><div class="l">Bloqueado</div></div>'+
    '<div class="box nao-testado"><div class="n">'+counts["nao-testado"]+'</div><div class="l">Não testado</div></div>';
}

renderSummary();
renderGherkin();
renderAcesso();
